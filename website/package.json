{
  "name": "maths-practice",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 8766 --strictPort",
    "build": "node scripts/validate-bank.mjs && vite build",
    "preview": "vite preview --host 127.0.0.1 --port 8766 --strictPort",
    "check": "svelte-kit sync && svelte-check --fail-on-warnings && prettier --check src scripts *.js *.json",
    "format": "prettier --write src scripts *.js *.json",
    "test": "node --test ../tests/*.test.mjs",
    "test:browser": "node ../scripts/browser-smoke.mjs"
  },
  "engines": {
    "node": ">=22.12"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.63.0",
    "@sveltejs/adapter-static": "4.0.0",
    "@sveltejs/kit": "3.0.0",
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "@tailwindcss/vite": "4.3.3",
    "bits-ui": "2.19.4",
    "daisyui": "5.7.47",
    "prettier": "3.9.9",
    "prettier-plugin-svelte": "4.1.1",
    "svelte": "5.57.1",
    "svelte-check": "4.7.6",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "vite": "8.3.2"
  },
  "imports": {
    "#lib/*": "./src/lib/*"
  }
}
